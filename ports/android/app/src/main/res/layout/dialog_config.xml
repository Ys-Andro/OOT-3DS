<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0E14"
    android:padding="8dp">

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:paddingTop="2dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_config_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ TriAevum — Configuración"
                android:textColor="#FFC107"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_config_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android · Renderizado Vulkan"
                android:textColor="#8B9BB4"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_config_restore"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_danger"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="Restaurar valores"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_config_save"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_gold"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Guardar"
                android:textColor="#1A1500"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_config_close"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/btn_dark"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Cerrar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2836"
        android:layout_marginBottom="6dp" />

    <!-- Main Content: Left Tabs + Right Panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Tab Navigation -->
        <ScrollView
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:background="@drawable/card_bg"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/tab_geral"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="🌐  General"
                    android:textColor="#FFD700"
                    android:background="@drawable/tab_selected_bg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />

                <Button
                    android:id="@+id/tab_graficos"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="🎨  Gráficos"
                    android:textColor="#8B9BB4"
                    android:background="@drawable/btn_dark"
                    android:textSize="12sp"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />

                <Button
                    android:id="@+id/tab_camera"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="📷  Cámara / HUD"
                    android:textColor="#8B9BB4"
                    android:background="@drawable/btn_dark"
                    android:textSize="12sp"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />

                <Button
                    android:id="@+id/tab_controles"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="🎮  Controles"
                    android:textColor="#8B9BB4"
                    android:background="@drawable/btn_dark"
                    android:textSize="12sp"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />
            </LinearLayout>
        </ScrollView>

        <View android:layout_width="6dp" android:layout_height="match_parent" />

        <!-- Right Panel Area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Panel: Geral -->
            <ScrollView
                android:id="@+id/panel_geral"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Idioma -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IDIOMA DEL JUEGO"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <Spinner
                            android:id="@+id/sp_language"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_dark"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp" />
                    </LinearLayout>

                    <!-- Resolução de Superfície -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LÍMITE DE RESOLUCIÓN DE SUPERFICIE"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Limita el tamaño de la superficie de renderizado Vulkan. Un límite menor puede mejorar el rendimiento."
                            android:textColor="#8B9BB4"
                            android:textSize="10sp"
                            android:layout_marginBottom="8dp" />

                        <Spinner
                            android:id="@+id/sp_surface_resolution"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_dark"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Panel: Gráficos -->
            <ScrollView
                android:id="@+id/panel_graficos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Renderização -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RENDERIZADO"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Escala de renderizado"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <Spinner android:id="@+id/sp_render_scale"
                                android:layout_width="140dp" android:layout_height="36dp"
                                android:background="@drawable/btn_dark" android:paddingLeft="8dp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Anti-Aliasing"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <Spinner android:id="@+id/sp_aa_mode"
                                android:layout_width="140dp" android:layout_height="36dp"
                                android:background="@drawable/btn_dark" android:paddingLeft="8dp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Frecuencia de fotogramas"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <Spinner android:id="@+id/sp_framerate"
                                android:layout_width="140dp" android:layout_height="36dp"
                                android:background="@drawable/btn_dark" android:paddingLeft="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Sincronização & Texturas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SINCRONIZACIÓN Y TEXTURAS"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="VSync"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_vsync"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Texturas personalizadas"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_custom_textures"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Panel: Câmera / HUD -->
            <ScrollView
                android:id="@+id/panel_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Câmera Livre -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CÁMARA LIBRE (C-STICK)"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Activar cámara libre"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_free_camera"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_cam_speed_label"
                            android:text="Velocidad: 3"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="4dp" />
                        <SeekBar android:id="@+id/sb_cam_speed"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="4" android:progress="2"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Invertir eje X"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_cam_invert_x"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Invertir eje Y"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_cam_invert_y"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- HUD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HUD"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diseño del HUD"
                            android:textColor="#8B9BB4"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />
                        <Spinner
                            android:id="@+id/sp_hud_layout"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_dark"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:layout_marginBottom="10dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_hud_scale_label"
                            android:text="Escala del HUD: 80%"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="4dp" />
                        <SeekBar android:id="@+id/sb_hud_scale"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="10" android:progress="3"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="10dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_hud_margin_x_label"
                            android:text="Margen horizontal (X): 4"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="4dp" />
                        <SeekBar android:id="@+id/sb_hud_margin_x"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="19" android:progress="7"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="10dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_hud_margin_y_label"
                            android:text="Margen vertical (Y): 1"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="4dp" />
                        <SeekBar android:id="@+id/sb_hud_margin_y"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="19" android:progress="4"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Mostrar minimapa"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_minimap"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Iconos en la cruceta"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_dpad_icons"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Consejos de objetos en el inventario"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_items_hint"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Panel: Controles -->
            <ScrollView
                android:id="@+id/panel_controles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Pantalla: proporción y tamaño -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="PANTALLA Y RELACIÓN DE ASPECTO" android:textColor="#FFC107"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Proporción del área de juego" android:textColor="#C8D8E8" android:textSize="12sp" />
                        <Spinner android:id="@+id/sp_aspect_ratio" android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp" />
                        <TextView android:id="@+id/tv_display_size_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Tamaño del área de juego: 100%"
                            android:textColor="#8B9BB4" android:textSize="11sp" />
                        <SeekBar android:id="@+id/sb_display_size" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:max="50" android:progress="50"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107" android:layout_marginBottom="6dp" />
                        <TextView android:id="@+id/tv_custom_width_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Ancho personalizado: 100%"
                            android:textColor="#8B9BB4" android:textSize="11sp" />
                        <SeekBar android:id="@+id/sb_custom_width" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:max="50" android:progress="50"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107" />
                        <TextView android:id="@+id/tv_custom_height_label" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Alto personalizado: 100%"
                            android:textColor="#8B9BB4" android:textSize="11sp" />
                        <SeekBar android:id="@+id/sb_custom_height" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:max="50" android:progress="50"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Los cambios de pantalla requieren reiniciar la partida."
                            android:textColor="#8B9BB4" android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Overlay Virtual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONTROLES VIRTUALES"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Mostrar controles en pantalla"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_show_overlay"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Editar posiciones (arrastra los controles)"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_edit_control_positions"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_opacity_label"
                            android:text="Opacidad de los controles: 100%"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="2dp" />
                        <SeekBar android:id="@+id/sb_overlay_opacity"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="100" android:progress="100"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="5dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Respuesta háptica / vibración"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_haptic"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="5dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Intercambiar pantallas (superior/inferior)"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_swap_screens"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="5dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Activar toque en la pantalla inferior"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_touch_screen"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="5dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Centro relativo del joystick"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_joystick_rel_center"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Deslizar en la cruceta"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_dpad_slide"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>
    </LinearLayout>

</LinearLayout>
